# Formularz kontaktowy: wartości uzupełnij wyłącznie w lokalnym lub serwerowym środowisku.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# Opcjonalny adres strony używany tylko w trybie development.
NEXT_PUBLIC_SITE_URL=

# Opcjonalne monitorowanie. DSN jest widoczny w kodzie przeglądarki.
NEXT_PUBLIC_SENTRY_DSN=
# Trasa testowa jest dostępna tylko po ustawieniu true; nie włączaj jej produkcyjnie.
SENTRY_TEST_ENABLED=false

# Opcjonalny, serwerowy token Storyblok dla obecnie wyłączonego portfolio.
STORYBLOK_DELIVERY_API_TOKEN=
STORYBLOK_REGION=eu

# NODE_ENV i NEXT_RUNTIME ustawia Next.js; nie wpisuj ich tutaj.
# PORT i HOSTNAME są ustawiane dla kontenera w Dockerfile.
# NEXT_TELEMETRY_DISABLED można ustawić w środowisku procesu na 1.
